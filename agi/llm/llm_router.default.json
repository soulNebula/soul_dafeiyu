{
  "backends": {
    "local": {
      "kind": "openai",
      "base_url": "http://127.0.0.1:8125/v1",
      "model": "local-vl-3b",
      "timeout_s": 60
    },
    "api": {
      "kind": "deepseek",
      "model": "deepseek-flash",
      "timeout_s": 30
    },
    "rule": {
      "kind": "rule"
    }
  },
  "purposes": {
    "video_understanding": {
      "backend": "api",
      "must_api": true,
      "note": "视频真理解必须 API"
    },
    "ingest_summary": {
      "backend": "local",
      "fallback": [
        "api"
      ],
      "max_tokens": 400
    },
    "comment_cluster": {
      "backend": "local",
      "fallback": [
        "api"
      ]
    },
    "keyword_extract": {
      "backend": "local",
      "fallback": [
        "api"
      ],
      "max_tokens": 200
    },
    "relevance_score": {
      "backend": "local",
      "fallback": [
        "rule"
      ]
    },
    "share_copy": {
      "backend": "api",
      "fallback": [
        "local"
      ]
    },
    "chat_reply": {
      "backend": "api"
    },
    "mood_judge": {
      "backend": "api"
    },
    "persona_reflect": {
      "backend": "api",
      "fallback": [
        "local"
      ]
    },
    "transcribe": {
      "backend": "local_whisper"
    },
    "selflearn_image_understanding": {
      "backend": "local",
      "fallback": [
        "api"
      ],
      "max_tokens": 500,
      "temperature": 0.2,
      "note": "识图：本地 Qwen2.5-VL-3B 优先，失败回落 API"
    },
    "selflearn_chat_caption": {
      "backend": "local",
      "fallback": [
        "api"
      ],
      "max_tokens": 200,
      "temperature": 0.2,
      "note": "聊天图片：本地 VL 生成描述（失败回落 API 视觉）"
    }
  },
  "budget": {
    "daily_api_tokens": 300000,
    "on_exceed": "local"
  },
  "log_path": "agi/data/llm_usage.jsonl"
}
